---
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = [
  {
    title: 'Why I rewrote my blog for the fourth time',
    date: '2026-06-02',
    linkedin: 'On the endless yak-shave of picking a static site generator, and why this time might stick. Sometimes the best productivity hack is admitting you\'ll never be done bikeshedding your own tools — ship it and move on. 🔁',
    markdown: `## Why I rewrote my blog for the fourth time

On the endless yak-shave of picking a static site generator, and why this time
might stick.

- Tried Jekyll, Hugo, a hand-rolled generator, now Astro
- The real lesson: content > tooling
- Shipping beats bikeshedding`,
  },
  {
    title: 'Notes on debugging a race condition at 2am',
    date: '2026-04-18',
    linkedin: 'A war story about a flaky test, a missing mutex, and three cups of coffee. Concurrency bugs humble even the most confident engineer — here\'s what finally cracked it. ☕',
    markdown: `## Notes on debugging a race condition at 2am

A war story about a flaky test, a missing mutex, and three cups of coffee.

1. The test failed 1 in 50 runs
2. Added logging, still nothing
3. Found the missing mutex around cup #3`,
  },
];
---

<BaseLayout title="Blog" active="blog">
  <section>
    <h3>Writing</h3>
    <div class="toggle" role="group" aria-label="Post format">
      <button type="button" id="btn-linkedin" class="active">LinkedIn version</button>
      <button type="button" id="btn-markdown">Markdown version</button>
    </div>
    {posts.map((post) => (
      <div class="item">
        <strong>{post.title}</strong> <span class="tag">{post.date}</span>
        <p class="view-linkedin">{post.linkedin}</p>
        <pre class="view-markdown" hidden>{post.markdown}</pre>
      </div>
    ))}
  </section>
</BaseLayout>

<script>
  const btnLinkedin = document.getElementById('btn-linkedin');
  const btnMarkdown = document.getElementById('btn-markdown');
  const linkedinViews = document.querySelectorAll<HTMLElement>('.view-linkedin');
  const markdownViews = document.querySelectorAll<HTMLElement>('.view-markdown');

  function showLinkedin() {
    linkedinViews.forEach((el) => (el.hidden = false));
    markdownViews.forEach((el) => (el.hidden = true));
    btnLinkedin?.classList.add('active');
    btnMarkdown?.classList.remove('active');
  }

  function showMarkdown() {
    linkedinViews.forEach((el) => (el.hidden = true));
    markdownViews.forEach((el) => (el.hidden = false));
    btnMarkdown?.classList.add('active');
    btnLinkedin?.classList.remove('active');
  }

  btnLinkedin?.addEventListener('click', showLinkedin);
  btnMarkdown?.addEventListener('click', showMarkdown);
</script>
